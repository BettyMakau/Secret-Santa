# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection (postgres:// and postgresql:// URLs are accepted too)
DATABASE_URL=postgresql+psycopg://santa:santa@localhost:5432/secret_santa
# Used by pytest — a separate database that the tests can wipe
TEST_DATABASE_URL=postgresql+psycopg://santa:santa@localhost:5432/secret_santa_test

# Public URL used in WhatsApp links (leave blank locally)
APP_BASE_URL=

# console = log messages only; meta = WhatsApp Cloud API
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
DEFAULT_COUNTRY_CODE=254
